# ============================================
# CodeVault 环境配置示例
# 复制此文件为 .env 并填写实际值
# 
# 生产环境建议使用 Docker Secrets 或 Vault
# 设置 *_FILE 变量指向密钥文件路径
# ============================================

# 应用配置
APP_NAME=CodeVault
APP_ENV=production
APP_DEBUG=false
APP_URL=https://codevault.example.com

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_NAME=codevault
DB_USER=codevault
DB_PASS=your_secure_password_here
# Docker Secrets 支持（生产环境推荐）
# DB_PASS_FILE=/run/secrets/db_password

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
# Docker Secrets 支持（生产环境推荐）
# REDIS_PASSWORD_FILE=/run/secrets/redis_password

# Git 配置
GIT_ROOT=/var/git/repositories
GIT_USER=git

# 安全配置
# 使用以下命令生成随机密钥：
# php -r "echo bin2hex(random_bytes(32)) . PHP_EOL;"
SESSION_SECRET=your_random_session_secret_here
JWT_SECRET=your_random_jwt_secret_here
# Docker Secrets 支持（生产环境推荐）
# SESSION_SECRET_FILE=/run/secrets/session_secret
# JWT_SECRET_FILE=/run/secrets/jwt_secret

# 邮件配置
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=noreply@example.com
MAIL_PASS=your_mail_password_here
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=CodeVault
# Docker Secrets 支持（生产环境推荐）
# MAIL_PASS_FILE=/run/secrets/mail_password

# 日志配置
LOG_PATH=/var/log/codevault
LOG_LEVEL=warning

# OAuth 配置（可选）
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GITLAB_CLIENT_ID=
OAUTH_GITLAB_CLIENT_SECRET=
# Docker Secrets 支持
# OAUTH_GITHUB_CLIENT_SECRET_FILE=/run/secrets/github_client_secret

# Webhook 配置
WEBHOOK_SECRET=your_webhook_secret_here
# Docker Secrets 支持
# WEBHOOK_SECRET_FILE=/run/secrets/webhook_secret

# 备份配置
BACKUP_PATH=/var/backups/codevault
BACKUP_RETENTION_DAYS=30

# 速率限制配置
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60
