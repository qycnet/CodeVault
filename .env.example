# CodeVault 生产环境配置
# 复制此文件为 .env 并修改为实际值

# 应用环境
APP_ENV=production
APP_DEBUG=false

# 数据库配置
DB_NAME=codevault
DB_USER=codevault
DB_PASS=your_strong_password_here_at_least_32_chars

# MySQL Root 密码
MYSQL_ROOT_PASSWORD=your_root_password_here_at_least_32_chars

# Redis 密码
REDIS_PASSWORD=your_redis_password_here_at_least_32_chars

# 注意事项：
# 1. 所有密码至少 32 位，包含大小写字母、数字、特殊字符
# 2. 生产环境不要提交 .env 文件到版本控制
# 3. 使用 Docker Secrets 或 Kubernetes Secrets 更安全
# 4. 定期轮换密码
